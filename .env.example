# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for extraction (see https://docs.claude.com for current model names)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: your per-million-token prices, so evals can report cost per invoice
INPUT_COST_PER_MTOK=
OUTPUT_COST_PER_MTOK=
DATABASE_PATH=invoices.db
